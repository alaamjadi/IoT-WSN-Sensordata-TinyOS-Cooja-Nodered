	{
		"id": "5c0674d8.2a518c",
		"type": "function",
		"z": "bf9f6d02.4d2be",
		"name": "Read TinyOS Serial Message",
		"func": "// MODIFY HERE WITH LENGTH OF PAYLOAD IN BYTES (temp=2 + hum=2)\nconst PAYLOAD_BYTES = 4;\n\nlet tempMsg = {};\nlet humMsg = {};\nlet combinedMsg = {};\nlet ready = false;\n\n// Initialize context\ncontext.bytes_received = context.bytes_received || 0;\ncontext.bytes_array = context.bytes_array || [];\n\n// Add incoming bytes to context buffer\ncontext.bytes_received += msg.payload.length;\nfor (let i = 0; i < msg.payload.length; i++) {\n  context.bytes_array.push(msg.payload[i]);\n}\n\n// Your original flow assumes:\n//   13 bytes framing/header + PAYLOAD_BYTES\nconst REQUIRED_BYTES = 13 + PAYLOAD_BYTES;\n\nif (context.bytes_received >= REQUIRED_BYTES) {\n  // Full frame collected\n  msg.payload = context.bytes_array;\n\n  // NOTE: These slices match the original project offsets.\n  // If your serial frame layout changes, adjust these indices.\n  const tempBytesArr = context.bytes_array.slice(10, -5);\n  const humBytesArr  = context.bytes_array.slice(12, -3);\n\n  // Reset buffer for next frame\n  context.bytes_received = 0;\n  context.bytes_array = [];\n\n  // Convert to Buffer\n  const tempBuf = Buffer.from(tempBytesArr);\n  const humBuf  = Buffer.from(humBytesArr);\n\n  // Read raw samples\n  const tempRaw = tempBuf.readUInt16BE(0);\n  const humRaw  = humBuf.readUInt16BE(0);\n\n  tempMsg = { payload: tempRaw };\n  humMsg  = { payload: humRaw };\n\n  // Scale to 0..100\n  const temperature = Math.round(tempRaw * (100 / 65535));\n  const humidity    = Math.round(humRaw  * (100 / 65535));\n\n  combinedMsg.payload = {\n    date: new Date().toTimeString(),\n    Temperature: temperature,\n    Humidity: humidity,\n    raw: { tempRaw, humRaw }\n  };\n\n  ready = true;\n}\n\nif (ready) {\n  return [msg, tempMsg, humMsg, combinedMsg];\n}\nreturn null;\n",
